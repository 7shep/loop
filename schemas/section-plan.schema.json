{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop section plan",
  "type": "object",
  "required": ["section_id", "objective", "target_words", "claims", "structure"],
  "properties": {
    "section_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "target_words": {"type": "integer", "minimum": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "evidence_required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "evidence_required": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "structure": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string"}}
  }
}
